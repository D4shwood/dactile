%
% Draft: a sans font for reading on screen, 1.5 spacing, numbered lines, and
% "TASLAK 0.1" on the cover. Final: a serif font, single spacing, the starred
% characters on the cover.

\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{tiyatro-theme}{2026-10-30}{1.4.0}{Dactile: page, fonts, cover}
\RequirePackage{fontspec}
\RequirePackage{setspace}
\RequirePackage{geometry}

\geometry{a4paper, top=2.5cm, bottom=2.5cm, left=3cm, right=3cm}
\setlength \parindent { 0pt }

% ------------------------------------------------------------------ fonts

% The first of the fonts that is installed. No babel: Turkish works through
% fontspec, and babel's Turkish shorthands clash with it.
\cs_new_protected:Npn \__tiy_main_font:n #1
  { \clist_map_inline:nn {#1} { \IfFontExistsTF {##1} { \setmainfont {##1} \clist_map_break: } { } } }

% A draft reads as the final copy does, with room between its lines.
\cs_new_protected:Npn \__tiy_own_font:
  { \__tiy_main_font:n { Times~New~Roman, TeX~Gyre~Termes, Liberation~Serif, DejaVu~Serif } }
\__tiy_own_font:
\iftiyatrodraft \setstretch { 1.15 } \else \singlespacing \fi

% The play's own font, in the preamble. Empty is the class's; one that isn't
% installed here only warns, so a play still builds on another computer.
\NewDocumentCommand \playfont { m }
  {
    \tl_if_blank:nTF {#1}
      { \__tiy_own_font: }
      {
        \IfFontExistsTF {#1}
          { \setmainfont {#1} }
          { \msg_warning:nnn { tiyatro } { font } {#1} }
      }
  }

% The size of the play's text in points. Headings keep their own.
\NewDocumentCommand \playfontsize { m }
  {
    \tl_if_blank:nF {#1}
      {
        \regex_match:nnF { \A \d+ (\.\d+)? \Z } {#1}
          { \msg_error:nnn { tiyatro } { fontsize } {#1} }
        \AtBeginDocument
          {
            \cs_gset_protected:Npn \normalsize { \fontsize {#1} { \fp_eval:n { #1 * 1.2 } } \selectfont }
            \normalsize
          }
      }
  }

% Line numbers use the mono font.
\cs_new_protected:Npn \__tiy_mono_font:n #1
  { \clist_map_inline:nn {#1} { \IfFontExistsTF {##1} { \setmonofont {##1} \clist_map_break: } { } } }
\__tiy_mono_font:n { Latin~Modern~Mono, DejaVu~Sans~Mono, Liberation~Mono }

% Small caps in Turkish: İ stays dotted.
\newcommand \tiyturkish { \addfontfeature { Language = Turkish } }
\newcommand \namefont { \tiyturkish \scshape }
\newcommand \starfont { \tiyturkish \bfseries \scshape }
\newcommand \actionfont { \itshape }
\newcommand \stagedirfont { \normalfont }
\newcommand \castfont { \tiyturkish \scshape }
\newcommand \caststarfont { \tiyturkish \bfseries \scshape \large }
\newcommand \casttitlefont { \tiyturkish \scshape \Large }
\newcommand \sectiontitlefont { \tiyturkish \scshape \Large }
\newcommand \scenecastfont { \tiyturkish \scshape \small }
\newcommand \scenetitlefont { \tiyturkish \scshape \large }
\newcommand \acttitlefont { \tiyturkish \scshape \Large }
\newcommand \linenumberfont { \normalfont \tiny \ttfamily }

% ------------------------------------------------------------------ spacing

\newlength \beforesceneskip  \setlength \beforesceneskip { 0pt }
\newlength \aftersceneskip   \setlength \aftersceneskip { \baselineskip }
\newlength \beforeactskip    \setlength \beforeactskip { \baselineskip }
\newlength \afteractskip     \setlength \afteractskip { \baselineskip }
\newlength \linenumbersep    \setlength \linenumbersep { 8pt }

\newlength \beforecasttitleskip  \setlength \beforecasttitleskip { 0pt }
\newlength \aftercasttitleskip   \setlength \aftercasttitleskip { 1cm }
\newlength \castpageleftmargin   \setlength \castpageleftmargin { 1.5cm }
\newlength \castpagerightmargin  \setlength \castpagerightmargin { 0pt }
\newlength \castnamewidth        \setlength \castnamewidth { 0.33 \linewidth }
\newcommand \castlistoptions
  {
    \setlength \itemsep { 0pt }
    \setlength \itemindent { 0pt }
    \setlength \topsep { 0pt }
    \setlength \parsep { 10pt }
    \setlength \listparindent { 0pt }
  }

