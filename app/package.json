{
  "name": "dactile-app",
  "private": true,
  "version": "0.3.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "wasm": "sh web/wasm.sh",
    "dev:web": "npm run wasm && vite -c vite.web.config.ts",
    "build:web": "npm run wasm && vite build -c vite.web.config.ts",
    "check:web": "npm run wasm && svelte-check --tsconfig ./tsconfig.web.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@tauri-apps/api": "^2.5.0",
    "lib0": "^0.2.120",
    "pdfjs-dist": "^4.10.38",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.5.0",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.28.2",
    "svelte-check": "^4.1.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
