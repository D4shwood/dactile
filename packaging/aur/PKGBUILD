# Maintainer: D4shwood <D4shwood@users.noreply.github.com>
# The desktop app and Dactile Light, from the release's archives.
pkgname=dactile-bin
_tag=v0.3.0-beta.1
pkgver=${_tag#v}
pkgver=${pkgver//-/_}
pkgrel=1
pkgdesc='Write stage plays for the tiyatro XeLaTeX class'
arch=(x86_64)
url='https://github.com/D4shwood/dactile'
license=(GPL-3.0-or-later)
depends=(gcc-libs glibc glib2 gtk3 hicolor-icon-theme webkit2gtk-4.1)
optdepends=(
  'texlive-xetex: building PDFs'
  'texlive-latexextra: building PDFs'
  'hunspell-tr: Turkish spell checking'
)
provides=(dactile dactile-light)
conflicts=(dactile dactile-light)
source=(
  "$url/releases/download/$_tag/dactile-$_tag-x86_64-linux.tar.gz"
  "$url/releases/download/$_tag/dactile-light-$_tag-x86_64-linux.tar.gz"
)
sha256sums=('SKIP' 'SKIP')

package() {
  cd "dactile-$_tag-x86_64-linux"
  install -Dm755 dactile -t "$pkgdir/usr/bin"
  install -Dm644 io.github.d4shwood.dactile.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.d4shwood.dactile.png"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -d "$pkgdir/usr/lib/dactile"
  cp -r ocr "$pkgdir/usr/lib/dactile/"
  install -Dm755 "../dactile-light-$_tag-x86_64-linux/dactile-light" -t "$pkgdir/usr/bin"
}
